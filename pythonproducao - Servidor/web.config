<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>

        <httpPlatform processPath="D:\ELETROINOX\Sistemas\Controle_de_Producao\venv_server\Scripts\python.exe" 
                      arguments="D:\ELETROINOX\Sistemas\Controle_de_Producao\manage.py runserver %HTTP_PLATFORM_PORT%" 
                      stdoutLogEnabled="true" 
                      stdoutLogFile="D:\ELETROINOX\Sistemas\Controle_de_Producao\logs\python.log">
        
<environmentVariables>
                <environmentVariable name="TZ" value="America/Sao_Paulo" />
            </environmentVariables>


</httpPlatform>

        <httpRedirect enabled="false" destination="" />
        
        <staticContent>
            <remove fileExtension=".ttf" />
            <mimeMap fileExtension=".ttf" mimeType="application/x-font-ttf" />
        </staticContent>
    </system.webServer>
</configuration>